---
import Base from '../../layouts/Base.astro';
import PostGrid from '../../components/PostGrid.astro';
import { PILLARS } from '../../consts';
import { getPosts, url } from '../../lib';

const posts = await getPosts();
---
<Base title="Writing" description="Notes on building AI agents, AI strategy for leaders, AI in business and leading engineers in the AI era.">
  <section class="wrap hero">
    <h1 class="statement wide"><strong>Writing.</strong> Notes from the build side of AI: agents in production, AI strategy, and leading teams through it.</h1>
    <div class="filters">
      <a class="pill" href={url('/blog')} aria-current="page">All</a>
      {PILLARS.map((p) => <a class="pill" href={url(`/tags/${p.tag}`)}>{p.title}</a>)}
      <a class="pill" href={url('/rss.xml')}>RSS</a>
    </div>
  </section>
  <section class="wrap">
    {posts.length > 0 ? <PostGrid posts={posts} /> : <p class="muted empty">The first post is on its way. Follow along on LinkedIn or by RSS.</p>}
  </section>
</Base>

<style>
  .hero { padding-top: 4.5rem; padding-bottom: 3rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 2rem; }
  .empty { font-size: 1.15rem; border-top: 1px solid var(--rule); padding-top: 2rem; }
</style>
