---
import Base from '../layouts/Base.astro';
import HeroConsole from '../components/HeroConsole.astro';
import RotatingWord from '../components/RotatingWord.astro';
import Pipeline from '../components/diagrams/Pipeline.astro';
import TagDiagram from '../components/diagrams/TagDiagram.astro';
import PostGrid from '../components/PostGrid.astro';
import { SITE, PILLARS } from '../consts';
import { getPosts, url } from '../lib';

const posts = (await getPosts()).slice(0, 3);
const tones = ['', 'navy', 'teal', 'gold'];
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker mono"><span class="kicker-dot" aria-hidden="true"></span>{SITE.role} · {SITE.location}</p>
        <h1 class="statement hero-title">
          <strong>From prompts</strong> to production <RotatingWord words={['agents.', 'evals.', 'teams.', 'results.']} />
        </h1>
        <p class="lede">
          I'm Abhishek Ramkrishna. I lead engineering at Whatfix and write about how AI actually gets built, shipped and run
          in real businesses, for engineering leaders, junior engineers and founders.
        </p>
        <div class="hero-actions">
          <a class="btn dark" href={url('/blog')}>Read the writing →</a>
          <a class="btn" href={SITE.links.linkedin}>Follow on LinkedIn</a>
        </div>
        <p class="hint mono">↳ pick a question in the console to watch an agent work it</p>
      </div>
      <HeroConsole />
    </div>
  </section>

  <section class="wrap block">
    <div class="section-head"><h2>What I write about</h2><a href={url('/blog')}>All writing →</a></div>
    <ul class="pillars">
      {PILLARS.map((p, i) => (
        <li>
          <a class="pillar" href={url(`/tags/${p.tag}`)}>
            <span class="chip">{p.tag}</span>
            <span class:list={['panel', 'pillar-art', tones[i]]}><TagDiagram tag={p.tag} /></span>
            <h3>{p.title}</h3>
            <p class="muted">{p.blurb}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block">
    <div class="section-head"><h2>How I take AI to production</h2></div>
    <div class="split">
      <p class="statement">
        <strong>A demo is one good run.</strong> Production is the same result every day, at a cost you can explain, with
        someone who owns it when it breaks.
      </p>
      <p class="muted split-copy">
        Most AI projects stall between the prototype and the launch. The gap is rarely the model. It's evals, guardrails and
        observability, and a team that knows what "good" looks like. That's the part I write about most.
      </p>
    </div>
    <figure class="panel pipeline-panel">
      <div class="pipeline"><Pipeline /></div>
    </figure>
  </section>

  {posts.length > 0 && (
    <section class="wrap block">
      <div class="section-head"><h2>Latest writing</h2><a href={url('/blog')}>All posts →</a></div>
      <PostGrid posts={posts} />
    </section>
  )}

  <section class="wrap block">
    <div class="section-head"><h2>Elsewhere</h2></div>
    <ol class="numbered">
      <li>
        <span class="num mono">01</span>
        <div><h3>Writing</h3><p class="muted">Long-form posts here first, then shared on <a href={SITE.links.linkedin}>LinkedIn</a> and X. Subscribe by <a href={url('/rss.xml')}>RSS</a>.</p></div>
      </li>
      <li>
        <span class="num mono">02</span>
        <div><h3>Speaking</h3><p class="muted">Happy to talk about AI agents in production, AI strategy for engineering orgs, and growing engineers in the AI era. Reach out on LinkedIn.</p></div>
      </li>
      <li>
        <span class="num mono">03</span>
        <div><h3>Building</h3><p class="muted">Code and experiments on <a href={SITE.links.github}>GitHub</a>.</p></div>
      </li>
      <li>
        <span class="num mono">04</span>
        <div><h3>Bangalore</h3><p class="muted">Always up for coffee with builders and founders in the city working on AI products.</p></div>
      </li>
    </ol>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: -72px;
    padding-top: 72px;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(circle, rgb(15 42 68 / 0.14) 1px, transparent 1.2px);
    background-size: 22px 22px;
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; padding-top: 4.5rem; padding-bottom: 5rem; }
  .kicker { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--ink-soft); padding: 0.35rem 0.8rem; border: 1px solid var(--rule); border-radius: 999px; background: var(--bg); margin: 0 0 1.6rem; }
  .kicker-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); }
  .hero-title { font-size: clamp(2.5rem, 5.2vw, 4.4rem); line-height: 1.04; max-width: none; }
  .lede { font-size: 1.18rem; color: var(--ink-soft); max-width: 34rem; margin: 1.6rem 0 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2rem; }
  .hint { color: var(--muted); margin: 1.6rem 0 0; }
  @media (prefers-color-scheme: dark) {
    .hero::before { background-image: radial-gradient(circle, rgb(95 179 179 / 0.16) 1px, transparent 1.2px); }
  }
  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; padding-top: 3rem; }
  }
  .block { padding-top: 6rem; }
  .pillars { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; }
  .pillar { display: grid; gap: 0.9rem; color: var(--ink); text-decoration: none; }
  .pillar-art { aspect-ratio: 1 / 1; padding: 10%; transition: transform 0.2s; }
  .pillar:hover .pillar-art { transform: translateY(-3px); }
  .pillar h3 { margin: 0.2rem 0 0; font-size: 1.3rem; letter-spacing: -0.02em; }
  .pillar:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .pillar p { margin: 0; font-size: 0.97rem; }
  .split { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: end; margin-bottom: 2.4rem; }
  .split .statement { font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .split-copy { font-size: 1.08rem; margin: 0; }
  .pipeline-panel { margin: 0; padding: clamp(1rem, 4vw, 3rem); }
  .pipeline { width: 100%; max-width: 980px; }
  @media (max-width: 640px) { .pipeline-panel { display: block; overflow-x: auto; } .pipeline { min-width: 620px; } }
  .numbered { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.4rem 3rem; }
  .numbered li { display: grid; grid-template-columns: 3rem 1fr; gap: 0.5rem; }
  .num { color: var(--gold); font-size: 1rem; padding-top: 0.15rem; }
  .numbered h3 { margin-bottom: 0.35rem; }
  .numbered p { margin: 0; }
  @media (max-width: 1000px) { .pillars { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) {
    .split, .numbered { grid-template-columns: 1fr; }
    .block { padding-top: 4.5rem; }
  }
  @media (max-width: 520px) { .pillars { grid-template-columns: 1fr; } }
</style>
