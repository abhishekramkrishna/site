---
// The parts of the Claude Code screen a mod can add to or act on.
---
<div class="dfig surfaces" role="img" aria-label="A Claude Code window. A mod can add a band above the prompt, a pane beside the chat, its own slash commands and toasts, and it can sit on every tool call as a gate.">
  <p class="df-title">Five places a mod can show up.</p>
  <div class="win">
    <div class="chat">
      <span class="lbl">chat</span>
      <div class="zone gate"><b>Gate on tool calls</b><span>see, change or stop each call</span></div>
    </div>
    <div class="zone pane"><b>Pane</b><span>a panel beside the chat that stays up and updates</span></div>
    <div class="zone toast"><b>Toast</b><span>a short notice</span></div>
    <div class="zone band"><b>Band above the prompt</b><span>one line, always in view</span></div>
    <div class="zone cmd"><b class="mono">/receipt</b><span>your own slash commands</span></div>
  </div>
</div>

<style>
  .win { display: grid; grid-template-columns: 1.7fr 1fr; grid-template-rows: auto auto auto; gap: 0.5rem; padding: 0.6rem; border: 1px solid var(--df-rule); border-radius: 12px; }
  .chat { grid-column: 1; grid-row: 1; position: relative; border: 1px dashed var(--df-rule); border-radius: 10px; padding: 1.6rem 0.8rem 0.8rem; min-height: 9rem; display: flex; align-items: center; }
  .lbl { position: absolute; top: 0.45rem; left: 0.7rem; font: 0.72rem var(--font-mono); color: var(--df-muted); }
  .zone { border: 1.5px solid var(--df-accent); background: var(--df-track); border-radius: 9px; padding: 0.5rem 0.7rem; display: flex; flex-direction: column; gap: 0.1rem; }
  .zone b { font-weight: 620; font-size: 0.86rem; }
  .zone span { font-size: 0.76rem; color: var(--df-muted); line-height: 1.3; }
  .gate { width: 100%; }
  .pane { grid-column: 2; grid-row: 1 / span 2; justify-content: center; }
  .toast { grid-column: 2; grid-row: 3; }
  .band { grid-column: 1; grid-row: 2; border-color: var(--df-hi); }
  .cmd { grid-column: 1; grid-row: 3; }
  .mono { font-family: var(--font-mono); font-weight: 500; color: var(--df-accent); }
  @media (max-width: 480px) { .win { grid-template-columns: 1fr; } .chat, .pane, .toast, .band, .cmd { grid-column: 1; grid-row: auto; } }
</style>
