---
// What finance leaders report about AI returns (Avalara, Jun 2026; Gartner, Sep 2026).
const stats: { n: number; text: string; src: string }[] = [
  { n: 92, text: 'of CFOs and senior finance leaders feel pressure to show AI is paying off', src: 'Avalara, 1,505 finance leaders, June 2026' },
  { n: 50, text: 'say their AI agents have delivered only limited measurable ROI', src: 'Same survey' },
  { n: 85, text: 'of functional leaders plan to increase AI spending in 2026', src: 'Gartner, 1,303 leaders, January to April 2026' },
];
---
<div class="dfig cfo" role="img" aria-label="92% of CFOs and senior finance leaders feel pressure to show AI is paying off, and 50% say their AI agents have delivered only limited measurable ROI (Avalara). 85% of functional leaders plan to increase AI spending in 2026 (Gartner).">
  <p class="df-title">Spend is rising faster than proof of return.</p>
  {stats.map((s, i) => (
    <div class="stat">
      <span class:list={['big df-num', { hi: i === 1 }]}>{s.n}%</span>
      <div class="txt">
        <p>{s.text}</p>
        <div class="df-track"><div class="df-bar" style={`width:${s.n}%;--i:${i}`}></div></div>
        <p class="src">{s.src}</p>
      </div>
    </div>
  ))}
  <blockquote class="df-fade">“They must not mistake activity for impact.”<span>Marco Steecker, Gartner, on how CFOs should judge AI</span></blockquote>
</div>

<style>
  .stat { display: grid; grid-template-columns: 4.6rem 1fr; gap: 0.9rem; align-items: start; padding: 0.8rem 0; border-top: 1px solid var(--df-rule); }
  .big { font-family: var(--font-sans); font-size: 2rem; font-weight: 720; letter-spacing: -0.04em; line-height: 1; }
  .txt p { margin: 0 0 0.45rem; font-size: 0.92rem; line-height: 1.35; }
  .txt .src { margin: 0.4rem 0 0; font-size: 0.75rem; color: var(--df-muted); }
  .df-track { height: 8px; }
  .hi { color: var(--df-hi); }
  blockquote { margin: 1rem 0 0; padding: 0 0 0 0.8rem; border: 0; border-left: 3px solid var(--df-hi); font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.3; color: var(--df-ink); }
  blockquote span { display: block; margin-top: 0.35rem; font: 400 0.78rem var(--font-sans); color: var(--df-muted); }
</style>
