---
// SkillsBench (Li et al., 2026): change in pass rate when agents get skills.
// Scale: 0 to 52 percentage points maps to 0 to 100% bar width.
const max = 52;
const rows: { label: string; v: number; tone: 'accent' | 'hi' | 'muted' }[] = [
  { label: 'Skills written by people, average', v: 16.2, tone: 'accent' },
  { label: 'Skills the model wrote for itself', v: -1.3, tone: 'muted' },
  { label: 'Software engineering tasks', v: 4.5, tone: 'accent' },
  { label: 'Healthcare tasks', v: 51.9, tone: 'hi' },
];
const fmt = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v)} pts`;
---
<div class="dfig sb" role="img" aria-label="SkillsBench results, change in agent pass rate with skills. Skills written by people raised the average pass rate by 16.2 percentage points. Skills the model wrote for itself changed it by minus 1.3 points. By domain, software engineering tasks gained 4.5 points and healthcare tasks gained 51.9 points.">
  <p class="df-title">Skills help most where the knowledge is yours, not the model's.</p>
  {rows.map((r, i) => (
    <div class:list={['row', { gap: i === 2 }]}>
      <p class="lab"><span>{r.label}</span><span class:list={['df-num', r.tone]}>{fmt(r.v)}</span></p>
      <div class="df-track"><div class:list={['df-bar', r.tone]} style={`width:${Math.max(Math.abs(r.v) / max * 100, 1.5)}%;--i:${i}`}></div></div>
    </div>
  ))}
  <p class="df-note">Change in pass rate, percentage points. 84 tasks, 11 domains, 7 agent and model setups. Benchmark result, not a field study.</p>
</div>

<style>
  .row { margin-bottom: 0.85rem; }
  .row.gap { margin-top: 1.4rem; padding-top: 1rem; border-top: 1px dashed var(--df-rule); }
  .lab { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; margin: 0 0 0.35rem; line-height: 1.3; }
  .df-num.hi { color: var(--df-hi); }
  .df-num.muted { color: var(--df-muted); }
  .df-bar.hi { background: var(--df-hi); }
  .df-bar.muted { background: var(--df-muted); }
</style>
