---
// How a team works with AI pair programmers: the review loop moves, ownership doesn't.
---
<svg class="diagram" viewBox="0 0 520 340" role="img" aria-label="An engineer works with an AI pair; a reviewer checks the change; a senior mentor coaches judgment; the engineer owns what ships">
  <defs>
    <marker id="tl-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" class="fill-line" />
    </marker>
  </defs>
  <circle class="node-gold" cx="110" cy="150" r="40" />
  <text class="t t-gold" x="110" y="146" text-anchor="middle">engineer</text>
  <text class="t-sm" x="110" y="164" text-anchor="middle">owns it</text>
  <rect class="node-teal" x="60" y="250" width="100" height="40" rx="8" />
  <text class="t" x="110" y="275" text-anchor="middle">AI pair</text>
  <path class="ln-teal" d="M96 190 L96 248" marker-end="url(#tl-arrow)" />
  <path class="ln-teal" d="M124 248 L124 192" marker-end="url(#tl-arrow)" />
  <text class="t-sm" x="30" y="226">draft</text>
  <text class="t-sm" x="134" y="226">edit</text>
  <path class="ln" d="M150 150 L246 150" marker-end="url(#tl-arrow)" />
  <rect class="node" x="250" y="126" width="110" height="48" rx="8" />
  <text class="t" x="305" y="155" text-anchor="middle">review</text>
  <path class="ln" d="M360 150 L410 150" marker-end="url(#tl-arrow)" />
  <rect class="node" x="414" y="126" width="80" height="48" rx="8" />
  <text class="t" x="454" y="155" text-anchor="middle">ship</text>
  <path class="ln dash" d="M305 126 C 300 70, 150 70, 118 108" marker-end="url(#tl-arrow)" />
  <text class="t-sm" x="215" y="66" text-anchor="middle">feedback on judgment, not syntax</text>
  <circle class="node" cx="305" cy="262" r="30" />
  <text class="t-sm" x="305" y="266" text-anchor="middle">mentor</text>
  <path class="ln faint dash" d="M275 262 L162 270 M305 232 L305 176" />
</svg>
