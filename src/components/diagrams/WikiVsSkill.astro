---
// The same team knowledge written as a wiki page and as an agent skill.
const rows: [string, string, string][] = [
  ['Who reads it', 'A person, if they find it', 'The agent, every time the task comes up'],
  ['When it is read', 'Onboarding week, then rarely', 'At the moment of the task'],
  ['How you know it works', 'You don\'t', 'Run the task with and without it'],
  ['When it goes stale', 'Nobody notices', 'The agent gets it wrong, in a PR you review'],
  ['Where it lives', 'A wiki nobody owns', 'The repo, with an owner and a review'],
];
---
<div class="dfig wvs" role="img" aria-label="A wiki page versus an agent skill. Who reads it: a wiki is read by a person if they find it; a skill is read by the agent every time the task comes up. When it is read: a wiki in onboarding week then rarely; a skill at the moment of the task. How you know it works: with a wiki you don't; with a skill you run the task with and without it. When it goes stale: nobody notices a stale wiki; a stale skill shows up as an agent mistake in a pull request you review. Where it lives: a wiki nobody owns, versus the repo, with an owner and a review.">
  <p class="df-title">Same knowledge, different reader.</p>
  <div class="head"><span></span><span>Wiki page</span><span>Agent skill</span></div>
  {rows.map(([q, wiki, skill], i) => (
    <div class="ln" style={`--i:${i}`}>
      <p class="q">{q}</p>
      <p class="wk">{wiki}</p>
      <p class="sk">{skill}</p>
    </div>
  ))}
  <p class="df-note">A skill is still documentation. The difference is that something reads it every time.</p>
</div>

<style>
  .head, .ln { display: grid; grid-template-columns: 0.9fr 1fr 1.1fr; gap: 0.9rem; align-items: baseline; }
  .head { font: 500 0.7rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--df-muted); padding: 0 0 0.5rem; border-bottom: 1px solid var(--df-rule); }
  .head span:last-child { color: var(--df-accent); }
  .ln { padding: 0.65rem 0; border-bottom: 1px solid var(--df-rule); }
  .ln p { margin: 0; line-height: 1.35; }
  .q { font-size: 0.9rem; font-weight: 600; }
  .wk { font-size: 0.84rem; color: var(--df-muted); }
  .sk { font-size: 0.86rem; color: var(--df-ink); border-left: 2px solid var(--df-accent); padding-left: 0.6rem; }
  @media (max-width: 560px) {
    .head { display: none; }
    .ln { grid-template-columns: 1fr; gap: 0.3rem; }
    .wk::before { content: 'Wiki: '; font-family: var(--font-mono); font-size: 0.7rem; }
    .sk::before { content: 'Skill: '; font-family: var(--font-mono); font-size: 0.7rem; color: var(--df-accent); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .dfig.motion .ln { opacity: 0; transform: translateX(-6px); transition: opacity 0.45s ease, transform 0.45s ease; transition-delay: calc(var(--i) * 120ms); }
    .dfig.motion.in-view .ln { opacity: 1; transform: none; }
  }
</style>
