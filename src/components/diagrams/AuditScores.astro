---
// Both repos scored against the 10-point audit, from src/audit.ts. Scored by the author on
// 28 Oct 2026 from what is in each repo; the evidence for each score is in the post.
import { POINTS, MAX, total } from '../../audit';

const site = total('site');
const lab = total('lab');
const label = (s: number) => ['missing', 'partly', 'in place'][s];
const aria = `Both of my public repos scored against the 10-point audit, 0 to 2 per point. This site: ${site} of ${MAX}. agent-harness-lab: ${lab} of ${MAX}. ` +
  POINTS.map((p) => `${p.n} ${p.name}: site ${label(p.site)}, lab ${label(p.lab)}.`).join(' ');
---
<div class="dfig audit" role="img" aria-label={aria}>
  <p class="df-title">Two repos, scored. Both are fine for people and weakest where only agents notice.</p>
  <div class="legend"><span class="k s">this site <b class="df-num">{site}/{MAX}</b></span><span class="k l">agent-harness-lab <b class="df-num">{lab}/{MAX}</b></span></div>
  <ol>
    {POINTS.map((p, i) => (
      <li>
        <span class="n">{String(p.n).padStart(2, '0')}</span>
        <span class="nm">{p.name}</span>
        <span class="pair">
          <span class="df-track"><span class="df-bar s" style={`width:${p.site * 50}%;--i:${i}`}></span></span>
          <span class="df-track"><span class="df-bar l" style={`width:${p.lab * 50}%;--i:${i}`}></span></span>
        </span>
        <span class="sc">{p.site}<br />{p.lab}</span>
      </li>
    ))}
  </ol>
  <p class="df-note">0 = missing, 1 = partly, 2 = in place. My own scoring of my own repos on 28 October 2026, from what is checked into each one.</p>
</div>

<style>
  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; font: 400 0.76rem var(--font-mono); color: var(--df-muted); margin-bottom: 0.7rem; }
  .k::before { content: ''; display: inline-block; width: 0.8rem; height: 0.55rem; border-radius: 3px; margin-right: 0.35rem; vertical-align: 0.05rem; }
  .k.s::before { background: var(--df-accent); }
  .k.l::before { background: var(--df-hi); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 1.6rem minmax(0, 1.3fr) minmax(0, 1fr) 1rem; gap: 0.6rem; align-items: center; padding: 0.45rem 0; border-top: 1px solid var(--df-rule); }
  .n { font: 500 0.76rem var(--font-mono); color: var(--df-accent); }
  .nm { font-size: 0.86rem; line-height: 1.3; }
  .pair { display: grid; gap: 0.25rem; }
  .pair .df-track { height: 8px; }
  .df-bar.l { background: var(--df-hi); }
  .sc { font: 400 0.7rem/1.15 var(--font-mono); color: var(--df-muted); text-align: right; }
</style>
