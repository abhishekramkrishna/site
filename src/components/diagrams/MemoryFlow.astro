---
// Four steps or questions behind one post in the agent-memory series, numbered and read in order.
// Content matches the post's social diagram and its alt text. Used by every post in the series.
interface Props { title: string; steps: [string, string][]; note?: string }
const { title, steps, note } = Astro.props;
const label = `${title} ${steps.map(([k, v], i) => `${i + 1}. ${k}: ${v}`).join(' ')}${note ? ` ${note}` : ''}`;
---
<div class="dfig memflow" role="img" aria-label={label}>
  <p class="df-title">{title}</p>
  <ol>
    {steps.map(([k, v], i) => (
      <li class:list={{ last: i === steps.length - 1 }}>
        <span class="n">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <p class="nm">{k}</p>
          <p class="what">{v}</p>
        </div>
        <div class="df-track"><div class="df-bar" style={`width:100%;--i:${i}`}></div></div>
      </li>
    ))}
  </ol>
  {note && <p class="df-note">{note}</p>}
</div>

<style>
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  li { display: grid; grid-template-columns: 2.2rem 1fr; column-gap: 0.6rem; padding: 0.7rem 0.8rem; border: 1px solid var(--df-rule); border-radius: 10px; }
  li.last { border: 1.5px solid var(--df-hi); }
  li .df-track { grid-column: 2; height: 3px; margin-top: 0.5rem; }
  li.last .df-bar { background: var(--df-hi); }
  .n { font: 500 0.8rem var(--font-mono); color: var(--df-accent); padding-top: 0.12rem; }
  li.last .n, li.last .nm { color: var(--df-hi); }
  p { margin: 0; line-height: 1.35; }
  .nm { font-weight: 650; font-size: 0.95rem; }
  .what { font-size: 0.86rem; color: var(--df-muted); margin-top: 0.2rem; }
  @media (max-width: 640px) { ol { grid-template-columns: 1fr; } }
</style>
