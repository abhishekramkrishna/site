---
// Personal mark: an "A" drawn as a small agent graph. Two worker nodes, one gold orchestrator node.
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo-mark">
  <path d="M16 6 L6.5 26 M16 6 L25.5 26" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <path d="M10.5 18 L21.5 18" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2 2.4" stroke-linecap="round" />
  <circle cx="6.5" cy="26" r="3" fill="var(--bg)" stroke="currentColor" stroke-width="2" />
  <circle cx="25.5" cy="26" r="3" fill="var(--bg)" stroke="currentColor" stroke-width="2" />
  <circle cx="16" cy="6" r="3.6" fill="#E1B03B" />
</svg>
