---
// Personal mark: ARK. A clean A and R, then a K whose arms branch from one gold node,
// the way an orchestrator routes work to agents.
interface Props { size?: number }
const { size = 32 } = Astro.props;
---
<svg width={size * 1.4} height={size} viewBox="0 0 56 40" aria-hidden="true" class="logo-mark">
  <g fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 35 L11 5 L19 35" />
    <path d="M6.5 25 H15.5" />
    <path d="M24 35 V5 H30 A6.5 6.5 0 0 1 30 18 H24" />
    <path d="M28.5 18 L35 35" />
    <path d="M41 5 V35" />
  </g>
  <g fill="none" stroke="#5FB3B3" stroke-width="2.6" stroke-linecap="round">
    <path d="M41 20 L52 6" />
    <path d="M41 20 L52 34" />
  </g>
  <circle cx="52" cy="6" r="3" fill="var(--bg)" stroke="#5FB3B3" stroke-width="2.4" />
  <circle cx="52" cy="34" r="3" fill="var(--bg)" stroke="#5FB3B3" stroke-width="2.4" />
  <circle cx="41" cy="20" r="4.6" fill="#E1B03B" />
</svg>
